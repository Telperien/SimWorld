<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Simulation/Simulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../data/terrain.json" Link="data/terrain.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../data/vegetation.json" Link="data/vegetation.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../data/species.json" Link="data/species.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../data/simulation.json" Link="data/simulation.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
