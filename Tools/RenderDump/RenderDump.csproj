<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Simulation/Simulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../data/terrain.json" Link="data/terrain.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../data/vegetation.json" Link="data/vegetation.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../data/species.json" Link="data/species.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../data/simulation.json" Link="data/simulation.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
